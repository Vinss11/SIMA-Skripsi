  updatedAt timestamptz [not null]
  Note: 'CURRENT — tabel fisik yang didefinisikan backend Sequelize/migration'
}

Table MasterPenanggungJawabPenjalurans {
  id integer [pk, increment, not null]
  ketua_itsc_dosen_id integer [ref: > Dosens.id]
  ketua_sirkel_dosen_id integer [ref: > Dosens.id]
  ketua_siber_dosen_id integer [ref: > Dosens.id]
  ketua_mvk_dosen_id integer [ref: > Dosens.id]
  pengawas_magang_dosen_id integer [ref: > Dosens.id]
  pengawas_pengabdian_dosen_id integer [ref: > Dosens.id]
  pengawas_perintisan_bisnis_dosen_id integer [ref: > Dosens.id]
  updated_by_sekretaris_id integer [ref: > SekretarisProdis.id]
  createdAt timestamptz [not null]
  updatedAt timestamptz [not null]
  Note: 'CURRENT — tabel fisik yang didefinisikan backend Sequelize/migration'
}

Table DosenKetersediaanPeriodes {
  id integer [pk, increment, not null]
  dosen_id integer [ref: > Dosens.id]
  periode_penjaluran_id integer [ref: > PeriodePenjalurans.id]
  tersedia_membimbing boolean
  updated_by_sekretaris_id integer [ref: > SekretarisProdis.id]
  configuration_status dosen_ketersediaan_periodes_configuration_status_enum
  reviewed_at timestamptz
  reviewed_by_sekretaris_id integer [ref: > SekretarisProdis.id]
  review_note text
  createdAt timestamptz [not null]
  updatedAt timestamptz [not null]
  Note: 'CURRENT — tabel fisik yang didefinisikan backend Sequelize/migration'
}

Table RiwayatKetersediaanMembimbings {
  id integer [pk, increment, not null]
  dosen_id integer [not null, ref: > Dosens.id]
  periode_penjaluran_id integer [not null, ref: > PeriodePenjalurans.id]
  tersedia_sebelumnya boolean
  tersedia_baru boolean [not null]
  changed_by_sekretaris_id integer [ref: > SekretarisProdis.id]
  sumber_perubahan riwayat_ketersediaan_membimbings_sumber_perubahan_enum [not null]
  createdAt timestamptz [not null]
  updatedAt timestamptz [not null]
  Note: 'CURRENT — tabel fisik yang didefinisikan backend Sequelize/migration'
}

Table RiwayatStatusDosens {
  id integer [pk, increment, not null]
  dosen_id integer [ref: > Dosens.id]
  status_sebelumnya riwayat_status_dosens_status_sebelumnya_enum
  status_baru riwayat_status_dosens_status_baru_enum
  account_is_active_sebelumnya boolean
  account_is_active_baru boolean
  continue_existing_supervision_sebelumnya boolean
  continue_existing_supervision_baru boolean
  changed_fields jsonb
  effective_at date
  reason text
  changed_by integer [ref: > Admins.id]
  impact_snapshot jsonb
  createdAt timestamptz [not null]
  updatedAt timestamptz [not null]
  Note: 'CURRENT — tabel fisik yang didefinisikan backend Sequelize/migration'
}

Table TindakLanjutStatusDosens {
  id integer [pk, increment, not null]
  dosen_id integer [ref: > Dosens.id]
  riwayat_status_dosen_id integer [ref: > RiwayatStatusDosens.id]
  status tindak_lanjut_status_dosens_status_enum
  impact_snapshot jsonb
  catatan_penyelesaian text
  resolved_by_sekretaris_id integer [ref: > SekretarisProdis.id]
  resolved_at timestamptz
  resolution_type tindak_lanjut_status_dosens_resolution_type_enum
  resolution_decisions jsonb [not null]
  remaining_impact_snapshot jsonb
  createdAt timestamptz [not null]
  updatedAt timestamptz [not null]
  Note: 'CURRENT — tabel fisik yang didefinisikan backend Sequelize/migration'
}

// ============================================================================
// PENJALURAN DAN PENGAJUAN
// ============================================================================

Table Topiks {
  id integer [pk, increment, not null]
  kode varchar(20) [not null, unique]
  judul varchar(255) [not null]
  deskripsi text
  keyword varchar(500)
  cluster topiks_cluster_enum [not null]
  status topiks_status_enum [not null, default: 'available']
  dosen_id integer [not null, ref: > Dosens.id]
  createdAt timestamptz [not null]
  updatedAt timestamptz [not null]
  Note: 'CURRENT — tabel fisik yang didefinisikan backend Sequelize/migration'
}

Table MitraMagangs {
  id integer [pk, increment, not null]
  nama varchar(180) [not null, unique]
  bidang_jenis varchar(180)
  lokasi varchar(180)
  email_kontak varchar(180)
  website varchar(255)
  posisi_magang varchar(180)
  quota_magang integer
  kriteria text
  prosedur_perusahaan text
  status mitra_magangs_status_enum [not null, default: 'active']
  is_active boolean [not null, default: true]
  catatan text
  createdAt timestamptz [not null]
  updatedAt timestamptz [not null]
  Note: 'CURRENT — tabel fisik yang didefinisikan backend Sequelize/migration'
}

Table KelompokPerintisanBisnis {
  id integer [pk, increment]
  periode_penjaluran_id integer [not null, ref: > PeriodePenjalurans.id]
  ketua_mahasiswa_id integer [not null, ref: > Mahasiswas.id]
  status kelompok_perintisan_bisnis_status_enum [not null, default: 'draft']
  review_reason_code varchar(80)
  review_detail json
  review_requested_at timestamptz
  createdAt timestamptz [not null]
  updatedAt timestamptz [not null]
  Note: 'CURRENT — tabel fisik yang didefinisikan backend Sequelize/migration'
}

Table AnggotaKelompokPerintisans {
  id integer [pk, increment]
  kelompok_id integer [not null, ref: > KelompokPerintisanBisnis.id]
  mahasiswa_id integer [not null, ref: > Mahasiswas.id]
  pendaftaran_penjaluran_id integer [not null, ref: > PendaftaranPenjalurans.id]
  posisi anggota_kelompok_perintisans_posisi_enum [not null]
  peran_tim anggota_kelompok_perintisans_peran_tim_enum [not null]
  jenis_pendaftaran anggota_kelompok_perintisans_jenis_pendaftaran_enum [not null]
  createdAt timestamptz [not null]
  updatedAt timestamptz [not null]
  Note: 'CURRENT — tabel fisik yang didefinisikan backend Sequelize/migration'
}

Table PendaftaranPenjalurans {
  id integer [pk, increment]
  mahasiswa_id integer [not null, ref: > Mahasiswas.id]
  pendaftaran_asal_id integer [ref: > PendaftaranPenjalurans.id]
  change_idempotency_key varchar(255)
  change_fingerprint varchar(64)
  periode_penjaluran_id integer [not null, ref: > PeriodePenjalurans.id]
  jalur pendaftaran_penjalurans_jalur_enum [not null, default: 'baru']
  program_kuliah pendaftaran_penjalurans_program_kuliah_enum [not null, default: 'reguler']
  semester_mahasiswa integer [not null]
  nomor_whatsapp varchar(20)
  catatan text
  status pendaftaran_penjalurans_status_enum [not null, default: 'submitted']
  dosen_pembimbing_akademik_id integer [ref: > Dosens.id]
  jenis_jalur_diambil pendaftaran_penjalurans_jenis_jalur_diambil_enum
  dosen_pembimbing_ta_id integer [ref: > Dosens.id]
  calon_dosen_pembimbing_id integer [ref: > Dosens.id]
  penjaluran_sebelumnya pendaftaran_penjalurans_penjaluran_sebelumnya_enum
  penjaluran_baru pendaftaran_penjalurans_penjaluran_baru_enum
  dosen_pembimbing_ta_sebelumnya_id integer [ref: > Dosens.id]
  dosen_pembimbing_ta_baru_id integer [ref: > Dosens.id]
  reviewed_by_sekretaris_id integer [ref: > SekretarisProdis.id]
  reviewed_at timestamptz
  approval_note text
  form_lanjutan_status pendaftaran_penjalurans_form_lanjutan_status_enum [not null, default: 'draft']
  form_lanjutan_submitted_at timestamptz
  form_lanjutan_payload jsonb
  createdAt timestamptz [not null]
  updatedAt timestamptz [not null]
  Note: 'CURRENT — tabel fisik yang didefinisikan backend Sequelize/migration'
}

Table Pengajuans {
  id integer [pk, increment]
  mahasiswa_id integer [not null, ref: > Mahasiswas.id]
  jenis_jalur pengajuans_jenis_jalur_enum [not null, default: 'baru']
  tipe_pengajuan pengajuans_tipe_pengajuan_enum [not null, default: 'topik_dosen']
  topik_1_kode varchar(20)
  topik_1_judul varchar(255)
  topik_2_kode varchar(20)
  topik_2_judul varchar(255)
  topik_3_kode varchar(20)
  topik_3_judul varchar(255)
  judul_mandiri varchar(500)
  deskripsi_mandiri text
  keyword_mandiri varchar(500)
  cluster_mandiri varchar(20)
  prospective_supervisor_id integer [ref: > Dosens.id]
  is_approved_by_supervisor boolean [default: false]
  dosen_pilihan_1 integer [ref: > Dosens.id]
  dosen_1_nama varchar(100)
  dosen_pilihan_2 integer [ref: > Dosens.id]
  dosen_2_nama varchar(100)
  dosen_pilihan_3 integer [ref: > Dosens.id]
  dosen_3_nama varchar(100)
  dosen_saat_ini integer [ref: > Dosens.id]
  pengajuan_sebelumnya_id integer [ref: > Pengajuans.id]
  pendaftaran_penjaluran_id integer [ref: > PendaftaranPenjalurans.id]

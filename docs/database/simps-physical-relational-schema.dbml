Table PeriodeAkademiks {
  id integer [pk, increment]
  kode varchar(40) [not null, unique]
  external_id varchar(120)
  tahun_mulai integer
  tahun_selesai integer
  tahun_akademik varchar(20) [not null]
  semester periode_akademiks_semester_enum [not null]
  tanggal_mulai timestamptz
  tanggal_selesai timestamptz
  status periode_akademiks_status_enum [not null, default: 'draft']
  sumber varchar(80) [not null, default: 'manual']
  metadata jsonb [not null]
  createdAt timestamptz [not null]
  updatedAt timestamptz [not null]
  Note: 'CURRENT — tabel fisik yang didefinisikan backend Sequelize/migration'
}

Table PeriodePenjalurans {
  id integer [pk, increment]
  tahun_akademik varchar(20) [not null]
  semester periode_penjalurans_semester_enum [not null]
  label_periode varchar(50) [not null, unique]
  tanggal_mulai timestamptz
  tanggal_selesai timestamptz
  is_active boolean [not null, default: true]
  status periode_penjalurans_status_enum [not null, default: 'active']
  ketua_penelitian_dosen_id integer [ref: > Dosens.id]
  pengawas_magang_dosen_id integer [ref: > Dosens.id]
  pengawas_pengabdian_dosen_id integer [ref: > Dosens.id]
  pengawas_perintisan_bisnis_dosen_id integer [ref: > Dosens.id]
  periode_akademik_id integer [ref: > PeriodeAkademiks.id]
  createdAt timestamptz [not null]
  updatedAt timestamptz [not null]
  Note: 'CURRENT — tabel fisik yang didefinisikan backend Sequelize/migration'
}

Table Klasters {
  id integer [pk, increment, not null]
  kode varchar(20) [not null, unique]
  nama varchar(120) [not null, unique]
  createdAt timestamptz [not null]
  updatedAt timestamptz [not null]
  Note: 'CURRENT — tabel fisik yang didefinisikan backend Sequelize/migration'
}

Table DosenKlasters {
  dosen_id integer [pk, not null, ref: > Dosens.id]
  klaster_id integer [pk, not null, ref: > Klasters.id]
  createdAt timestamptz [not null]
  updatedAt timestamptz [not null]
  Note: 'CURRENT — tabel fisik yang didefinisikan backend Sequelize/migration'
}

Table KlasterKetuaPeriodes {
  id integer [pk, increment, not null]
  klaster_id integer [not null, ref: > Klasters.id]
  dosen_id integer [not null, ref: > Dosens.id]
  periode_penjaluran_id integer [not null, ref: > PeriodePenjalurans.id]
  assigned_by_sekretaris_id integer [ref: > SekretarisProdis.id]

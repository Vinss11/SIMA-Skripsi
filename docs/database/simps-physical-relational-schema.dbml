// ============================================================================
// AKTOR DAN AKUN
// ============================================================================

Table Admins {
  id integer [pk, increment]
  nip varchar(20) [not null, unique]
  nama varchar(100) [not null]
  email varchar(100) [not null, unique]
  password varchar(255) [not null]
  is_default_password boolean [default: true]
  credential_state varchar(20) [not null, default: 'default']
  credential_version integer [not null, default: 1]
  password_changed_at timestamptz
  password_origin varchar(30)
  force_change_reason varchar(120)
  security_updated_at timestamptz
  security_updated_by_type varchar(30)
  security_updated_by_id integer
  recovery_email_verified_at timestamptz
  recovery_email_verification_source varchar(80)
  role admins_role_enum [not null, default: 'staff']
  createdAt timestamptz [not null]
  updatedAt timestamptz [not null]
  Note: 'CURRENT — tabel fisik yang didefinisikan backend Sequelize/migration'
}

Table Dosens {
  id integer [pk, increment, not null]
  kode_dosen varchar(255) [not null, unique]
  nik varchar(9) [unique]
  nama varchar(255) [not null]
  gelar varchar(255)
  email varchar(255) [not null, unique]
  password varchar(255) [not null]
  is_default_password boolean [default: true]
  credential_state varchar(20) [not null, default: 'default']
  credential_version integer [not null, default: 1]
  password_changed_at timestamptz
  password_origin varchar(30)
  force_change_reason varchar(120)
  security_updated_at timestamptz
  security_updated_by_type varchar(30)
  security_updated_by_id integer
  recovery_email_verified_at timestamptz
  recovery_email_verification_source varchar(80)
  jabatan_struktural varchar(255)
  kuota_bimbingan integer [not null, default: 5]
  status_keaktifan dosens_status_keaktifan_enum [not null, default: 'active']
  account_is_active boolean [not null, default: true]
  continue_existing_supervision boolean [not null, default: true]
  status_effective_at date
  status_reason text
  status_updated_by integer
  status_updated_at timestamptz
  createdAt timestamptz [not null]
  updatedAt timestamptz [not null]
  Note: 'CURRENT — tabel fisik yang didefinisikan backend Sequelize/migration'
}

Table SekretarisProdis {
  id integer [pk, increment]
  nik varchar(9) [not null, unique]
  nama varchar(100) [not null]
  email varchar(100) [not null, unique]
  password varchar(255) [not null]
  is_default_password boolean [not null, default: true]
  credential_state varchar(20) [not null, default: 'default']
  credential_version integer [not null, default: 1]
  password_changed_at timestamptz
  password_origin varchar(30)
  force_change_reason varchar(120)
  security_updated_at timestamptz
  security_updated_by_type varchar(30)
  security_updated_by_id integer
  recovery_email_verified_at timestamptz
  recovery_email_verification_source varchar(80)
  jabatan varchar(100)
  createdAt timestamptz [not null]
  updatedAt timestamptz [not null]
  Note: 'CURRENT — tabel fisik yang didefinisikan backend Sequelize/migration'
}

Table Mahasiswas {
  id integer [pk, increment]
  nim varchar(20) [not null, unique]
  nama varchar(100) [not null]
  email varchar(100) [not null, unique]
  password varchar(255) [not null]
  is_default_password boolean [default: true]
  credential_state varchar(20) [not null, default: 'default']
  credential_version integer [not null, default: 1]
  password_changed_at timestamptz
  password_origin varchar(30)
  force_change_reason varchar(120)
  security_updated_at timestamptz
  security_updated_by_type varchar(30)
  security_updated_by_id integer
  recovery_email_verified_at timestamptz
  recovery_email_verification_source varchar(80)
  angkatan varchar(10)
  dosen_pembimbing_akademik_id integer [ref: > Dosens.id]
  dosen_pembimbing_skripsi_id integer [ref: > Dosens.id]
  status_jalur_saat_ini mahasiswas_status_jalur_saat_ini_enum [not null, default: 'belum_mengajukan']
  pengajuan_aktif_id integer [ref: > Pengajuans.id]
  createdAt timestamptz [not null]
  updatedAt timestamptz [not null]
  Note: 'CURRENT — tabel fisik yang didefinisikan backend Sequelize/migration'
}

// ============================================================================
// PERIODE DAN TATA KELOLA

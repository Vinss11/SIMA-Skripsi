// SIMPS BPMN V1.2 — TAHAP 07: Penilaian, Revisi, dan Yudisium
// Urutan BPMN: Penguji memasukkan nilai → sistem menghitung hasil → jika revisi mahasiswa mengunggah → dosen approve/revisi ulang → verifikasi akademik → Sekprodi memformalkan yudisium → siklus ditutup
// Biru = CURRENT (sudah ada) | Oranye = PROPOSED (belum dimigrasikan)
// View ini hanya menampilkan kolom penggerak relasi/proses agar diagram terbaca.

Project SIMPS_BPMN_07 {
  database_type: 'PostgreSQL'
  Note: 'Penilaian, Revisi, dan Yudisium'
}

Table Dosens [headercolor: #2F75B5] {
  id integer [pk, increment]
  kode_dosen varchar(255) [not null, unique]
  nama varchar(255) [not null]
  status_keaktifan varchar(30) [not null]
  account_is_active boolean [not null]
  kuota_bimbingan integer [not null]
  Note: 'CURRENT — dosen, pembimbing, penguji, dan penanggung jawab jalur'
}

Table SekretarisProdis [headercolor: #2F75B5] {
  id integer [pk, increment]
  nik varchar(9) [not null, unique]
  nama varchar(100) [not null]
  Note: 'CURRENT — sekretaris program studi'
}

Table Mahasiswas [headercolor: #2F75B5] {
  id integer [pk, increment]
  nim varchar(20) [not null, unique]
  nama varchar(100) [not null]
  dosen_pembimbing_akademik_id integer [ref: > Dosens.id]
  dosen_pembimbing_skripsi_id integer [ref: > Dosens.id]
  status_jalur_saat_ini varchar(40) [not null]
  pengajuan_aktif_id integer
  Note: 'CURRENT — mahasiswa dan pointer status proses aktif'
}

Table PeriodeAkademiks [headercolor: #2F75B5] {
  id integer [pk, increment]
  kode varchar(40) [not null, unique]
  tahun_akademik varchar(20) [not null]
  semester varchar(10) [not null]
  Note: 'CURRENT — periode yudisium'
}

Table JadwalSidangPengujis [headercolor: #2F75B5] {
  id integer [pk, increment]
  mahasiswa_id integer [not null, ref: > Mahasiswas.id]
  penguji1_dosen_id integer [not null, ref: > Dosens.id]
  penguji2_dosen_id integer [not null, ref: > Dosens.id]
  assignment_status varchar(20) [not null]
  Note: 'CURRENT — sidang yang dinilai'
}

Table RubrikPenilaianSidangs [headercolor: #D97706] {
  id integer [pk, increment]
  kode varchar(40) [not null, unique]
  nama varchar(160) [not null]
  bobot decimal(5,2) [not null]
  is_active boolean [not null]
  Note: 'PROPOSED — master komponen nilai'
}

Table PenilaianSidangs [headercolor: #D97706] {
  id bigint [pk, increment]
  jadwal_sidang_penguji_id integer [not null, ref: > JadwalSidangPengujis.id]
  dosen_id integer [not null, ref: > Dosens.id]
  peran_penilai varchar(20) [not null]
  status varchar(20) [not null]
  nilai_total decimal(5,2)

  Indexes {
    (jadwal_sidang_penguji_id, dosen_id, peran_penilai) [unique]
  }
  Note: 'PROPOSED — header lembar nilai per penguji'
}

Table DetailNilaiSidangs [headercolor: #D97706] {
  id bigint [pk, increment]
  penilaian_sidang_id bigint [not null, ref: > PenilaianSidangs.id]
  rubrik_penilaian_sidang_id integer [not null, ref: > RubrikPenilaianSidangs.id]
  nilai decimal(5,2) [not null]
  Note: 'PROPOSED — nilai per komponen rubrik'
}

Table HasilSidangs [headercolor: #D97706] {
  id bigint [pk, increment]
  jadwal_sidang_penguji_id integer [not null, unique, ref: - JadwalSidangPengujis.id]
  nilai_akhir decimal(5,2)
  status_hasil varchar(30) [not null]
  batas_revisi_at timestamptz
  finalized_by_sekretaris_id integer [ref: > SekretarisProdis.id]
  Note: 'PROPOSED — hasil agregat dan keputusan sidang'
}

Table RevisiSkripsis [headercolor: #D97706] {
  id bigint [pk, increment]
  hasil_sidang_id bigint [not null, ref: > HasilSidangs.id]
  mahasiswa_id integer [not null, ref: > Mahasiswas.id]
  version_number integer [not null]
  file_path varchar(500) [not null]
  status varchar(30) [not null]
  Note: 'PROPOSED — versi revisi pasca-sidang'
}

Table PersetujuanRevisiSidangs [headercolor: #D97706] {
  id bigint [pk, increment]
  revisi_skripsi_id bigint [not null, ref: > RevisiSkripsis.id]
  dosen_id integer [not null, ref: > Dosens.id]
  peran_penilai varchar(20) [not null]
  keputusan varchar(30) [not null]
  decided_at timestamptz [not null]
  Note: 'PROPOSED — approval revisi oleh dosen'
}

Table Yudisiums [headercolor: #D97706] {
  id bigint [pk, increment]
  hasil_sidang_id bigint [not null, unique, ref: - HasilSidangs.id]
  mahasiswa_id integer [not null, ref: > Mahasiswas.id]
  periode_akademik_id integer [not null, ref: > PeriodeAkademiks.id]
  status varchar(20) [not null]
  nomor_keputusan varchar(120)
  tanggal_yudisium date
  verified_by_sekretaris_id integer [ref: > SekretarisProdis.id]
  Note: 'PROPOSED — keputusan akademik final'
}


<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_TopikDosenAktual"
  targetNamespace="https://sima.uii.ac.id/bpmn/penjaluran-topik-dosen-aktual">

  <bpmn:process id="Process_TopikDosenAktual" name="Penjaluran Penelitian - Topik Dosen (Implementasi Aktual)" isExecutable="false">
    <bpmn:laneSet id="LaneSet_TopikDosen">
      <bpmn:lane id="Lane_Sekprodi" name="Sekretaris Prodi">
        <bpmn:flowNodeRef>StartEvent_Persiapan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SiapkanPeriode</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TetapkanKetua</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PerbaikiMapping</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReviewFinal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_FinalApprove</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PilihPembimbing2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Sistem" name="Sistem SIMA">
        <bpmn:flowNodeRef>Task_ValidasiKesiapan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_PeriodeSiap</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_PeriodeBelumSiap</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AktifkanPeriode</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AutoApprovePendaftaran</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ValidasiTopik</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_DataValid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReservasiTopik</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_AdaLolosDosen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ResolusiKetua</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_KetuaTersedia</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SinkronkanMapping</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AutoSkipKonflik</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_AdaLolosKlaster</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_LepasTopikDitolak</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_MasihAdaTopik</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FinalisasiDisetujui</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FinalisasiDitolak</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Disetujui</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Ditolak</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Mahasiswa" name="Mahasiswa">
        <bpmn:flowNodeRef>Task_DaftarPenelitian</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PilihTopik</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PerbaikiPilihan</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Dosen" name="Dosen Pemilik Topik / Calon Pembimbing">
        <bpmn:flowNodeRef>Task_PublikasiTopik</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReviewDosen</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Ketua" name="Ketua Klaster">
        <bpmn:flowNodeRef>Task_ReviewKetua</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="StartEvent_Persiapan" name="Persiapan periode penjaluran"><bpmn:outgoing>Flow_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:userTask id="Task_SiapkanPeriode" name="Buat draft periode dan atur ketersediaan dosen"><bpmn:incoming>Flow_01</bpmn:incoming><bpmn:outgoing>Flow_02</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="Task_TetapkanKetua" name="Tetapkan Ketua Klaster SIRKEL, SIBER, ITSC, MVK"><bpmn:incoming>Flow_02</bpmn:incoming><bpmn:outgoing>Flow_03</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="Task_ValidasiKesiapan" name="Validasi penanggung jawab dan kesiapan periode"><bpmn:incoming>Flow_03</bpmn:incoming><bpmn:outgoing>Flow_04</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_PeriodeSiap" name="Periode siap diaktifkan?" default="Flow_05"><bpmn:incoming>Flow_04</bpmn:incoming><bpmn:outgoing>Flow_05</bpmn:outgoing><bpmn:outgoing>Flow_06</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:endEvent id="EndEvent_PeriodeBelumSiap" name="Periode belum dapat dibuka"><bpmn:incoming>Flow_05</bpmn:incoming></bpmn:endEvent>
    <bpmn:serviceTask id="Task_AktifkanPeriode" name="Aktifkan periode penjaluran"><bpmn:incoming>Flow_06</bpmn:incoming><bpmn:outgoing>Flow_07</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="Task_PublikasiTopik" name="Buat dan publikasikan topik berstatus available"><bpmn:incoming>Flow_07</bpmn:incoming><bpmn:outgoing>Flow_08</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="Task_DaftarPenelitian" name="Daftar jalur penelitian dan login"><bpmn:incoming>Flow_08</bpmn:incoming><bpmn:outgoing>Flow_09</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="Task_AutoApprovePendaftaran" name="Buat pendaftaran approved dan form lanjutan draft"><bpmn:incoming>Flow_09</bpmn:incoming><bpmn:outgoing>Flow_10</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="Task_PilihTopik" name="Pilih 1-3 topik dosen dan kirim pengajuan"><bpmn:incoming>Flow_10</bpmn:incoming><bpmn:incoming>Flow_13</bpmn:incoming><bpmn:outgoing>Flow_11</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="Task_ValidasiTopik" name="Validasi eligibility, topik, dosen, ketersediaan, dan kuota"><bpmn:incoming>Flow_11</bpmn:incoming><bpmn:outgoing>Flow_12</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_DataValid" name="Pengajuan valid?" default="Flow_13A"><bpmn:incoming>Flow_12</bpmn:incoming><bpmn:outgoing>Flow_13A</bpmn:outgoing><bpmn:outgoing>Flow_14</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_PerbaikiPilihan" name="Perbaiki pilihan atau data topik"><bpmn:incoming>Flow_13A</bpmn:incoming><bpmn:outgoing>Flow_13</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="Task_ReservasiTopik" name="Reservasi topik; buat Pengajuan pending dan riwayat per slot"><bpmn:incoming>Flow_14</bpmn:incoming><bpmn:outgoing>Flow_15</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="Task_ReviewDosen" name="Review dan putuskan setiap topik secara paralel">
      <bpmn:incoming>Flow_15</bpmn:incoming><bpmn:outgoing>Flow_16</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics isSequential="false"><bpmn:loopCardinality xsi:type="bpmn:tFormalExpression">${jumlahTopik}</bpmn:loopCardinality></bpmn:multiInstanceLoopCharacteristics>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_AdaLolosDosen" name="Ada topik disetujui pemilik?" default="Flow_17"><bpmn:incoming>Flow_16</bpmn:incoming><bpmn:outgoing>Flow_17</bpmn:outgoing><bpmn:outgoing>Flow_18</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_ResolusiKetua" name="Cari Ketua Klaster untuk setiap topik yang disetujui"><bpmn:incoming>Flow_18</bpmn:incoming><bpmn:incoming>Flow_23</bpmn:incoming><bpmn:outgoing>Flow_19</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_KetuaTersedia" name="Mapping Ketua Klaster tersedia?" default="Flow_20"><bpmn:incoming>Flow_19</bpmn:incoming><bpmn:outgoing>Flow_20</bpmn:outgoing><bpmn:outgoing>Flow_24</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_PerbaikiMapping" name="Tetapkan atau perbaiki mapping Ketua Klaster"><bpmn:incoming>Flow_20</bpmn:incoming><bpmn:outgoing>Flow_21</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="Task_SinkronkanMapping" name="Rekonsiliasi pengajuan menunggu Ketua Klaster"><bpmn:incoming>Flow_21</bpmn:incoming><bpmn:outgoing>Flow_23</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="Task_AutoSkipKonflik" name="Auto-approve validasi jika pemilik topik juga Ketua Klaster"><bpmn:incoming>Flow_24</bpmn:incoming><bpmn:outgoing>Flow_25</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="Task_ReviewKetua" name="Review setiap topik yang tidak auto-approved">
      <bpmn:incoming>Flow_25</bpmn:incoming><bpmn:outgoing>Flow_26</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics isSequential="false"><bpmn:loopCardinality xsi:type="bpmn:tFormalExpression">${jumlahTopikPerluReviewKlaster}</bpmn:loopCardinality></bpmn:multiInstanceLoopCharacteristics>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_AdaLolosKlaster" name="Ada topik lolos klaster?" default="Flow_27"><bpmn:incoming>Flow_26</bpmn:incoming><bpmn:outgoing>Flow_27</bpmn:outgoing><bpmn:outgoing>Flow_28</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_ReviewFinal" name="Review final per slot topik dan isi catatan">
      <bpmn:incoming>Flow_28</bpmn:incoming><bpmn:incoming>Flow_34</bpmn:incoming><bpmn:outgoing>Flow_29</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_FinalApprove" name="Satu topik disetujui final?" default="Flow_30"><bpmn:incoming>Flow_29</bpmn:incoming><bpmn:outgoing>Flow_30</bpmn:outgoing><bpmn:outgoing>Flow_35</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_LepasTopikDitolak" name="Lepaskan reservasi topik yang ditolak"><bpmn:incoming>Flow_30</bpmn:incoming><bpmn:outgoing>Flow_31</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_MasihAdaTopik" name="Masih ada topik lain yang dapat diproses?" default="Flow_32"><bpmn:incoming>Flow_31</bpmn:incoming><bpmn:outgoing>Flow_32</bpmn:outgoing><bpmn:outgoing>Flow_34</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_PilihPembimbing2" name="Tetapkan Pembimbing 2 bila diperlukan"><bpmn:incoming>Flow_35</bpmn:incoming><bpmn:outgoing>Flow_36</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="Task_FinalisasiDisetujui" name="Topik winner=taken; topik lain=available/cancelled; simpan pembimbing"><bpmn:incoming>Flow_36</bpmn:incoming><bpmn:outgoing>Flow_37</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="Task_FinalisasiDitolak" name="Set rejected; lepaskan semua reservasi; reset pengajuan aktif"><bpmn:incoming>Flow_17</bpmn:incoming><bpmn:incoming>Flow_27</bpmn:incoming><bpmn:incoming>Flow_32</bpmn:incoming><bpmn:outgoing>Flow_38</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_Disetujui" name="Penjaluran penelitian disetujui"><bpmn:incoming>Flow_37</bpmn:incoming></bpmn:endEvent>
    <bpmn:endEvent id="EndEvent_Ditolak" name="Penjaluran penelitian ditolak"><bpmn:incoming>Flow_38</bpmn:incoming></bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_01" sourceRef="StartEvent_Persiapan" targetRef="Task_SiapkanPeriode" />
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_SiapkanPeriode" targetRef="Task_TetapkanKetua" />
    <bpmn:sequenceFlow id="Flow_03" sourceRef="Task_TetapkanKetua" targetRef="Task_ValidasiKesiapan" />
    <bpmn:sequenceFlow id="Flow_04" sourceRef="Task_ValidasiKesiapan" targetRef="Gateway_PeriodeSiap" />
    <bpmn:sequenceFlow id="Flow_05" name="Tidak" sourceRef="Gateway_PeriodeSiap" targetRef="EndEvent_PeriodeBelumSiap" />
    <bpmn:sequenceFlow id="Flow_06" name="Ya" sourceRef="Gateway_PeriodeSiap" targetRef="Task_AktifkanPeriode"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${periodeSiap}</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_07" sourceRef="Task_AktifkanPeriode" targetRef="Task_PublikasiTopik" />
    <bpmn:sequenceFlow id="Flow_08" sourceRef="Task_PublikasiTopik" targetRef="Task_DaftarPenelitian" />
    <bpmn:sequenceFlow id="Flow_09" sourceRef="Task_DaftarPenelitian" targetRef="Task_AutoApprovePendaftaran" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_AutoApprovePendaftaran" targetRef="Task_PilihTopik" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_PilihTopik" targetRef="Task_ValidasiTopik" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_ValidasiTopik" targetRef="Gateway_DataValid" />
    <bpmn:sequenceFlow id="Flow_13A" name="Tidak" sourceRef="Gateway_DataValid" targetRef="Task_PerbaikiPilihan" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_PerbaikiPilihan" targetRef="Task_PilihTopik" />
    <bpmn:sequenceFlow id="Flow_14" name="Ya" sourceRef="Gateway_DataValid" targetRef="Task_ReservasiTopik"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${pengajuanValid}</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Task_ReservasiTopik" targetRef="Task_ReviewDosen" />
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Task_ReviewDosen" targetRef="Gateway_AdaLolosDosen" />
    <bpmn:sequenceFlow id="Flow_17" name="Tidak" sourceRef="Gateway_AdaLolosDosen" targetRef="Task_FinalisasiDitolak" />
    <bpmn:sequenceFlow id="Flow_18" name="Ya" sourceRef="Gateway_AdaLolosDosen" targetRef="Task_ResolusiKetua"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${adaTopikLolosDosen}</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_19" sourceRef="Task_ResolusiKetua" targetRef="Gateway_KetuaTersedia" />
    <bpmn:sequenceFlow id="Flow_20" name="Tidak" sourceRef="Gateway_KetuaTersedia" targetRef="Task_PerbaikiMapping" />
    <bpmn:sequenceFlow id="Flow_21" sourceRef="Task_PerbaikiMapping" targetRef="Task_SinkronkanMapping" />
    <bpmn:sequenceFlow id="Flow_23" sourceRef="Task_SinkronkanMapping" targetRef="Task_ResolusiKetua" />
    <bpmn:sequenceFlow id="Flow_24" name="Ya" sourceRef="Gateway_KetuaTersedia" targetRef="Task_AutoSkipKonflik"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${ketuaTersedia}</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_25" sourceRef="Task_AutoSkipKonflik" targetRef="Task_ReviewKetua" />
    <bpmn:sequenceFlow id="Flow_26" sourceRef="Task_ReviewKetua" targetRef="Gateway_AdaLolosKlaster" />
    <bpmn:sequenceFlow id="Flow_27" name="Tidak" sourceRef="Gateway_AdaLolosKlaster" targetRef="Task_FinalisasiDitolak" />
    <bpmn:sequenceFlow id="Flow_28" name="Ya" sourceRef="Gateway_AdaLolosKlaster" targetRef="Task_ReviewFinal"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${adaTopikLolosKlaster}</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_29" sourceRef="Task_ReviewFinal" targetRef="Gateway_FinalApprove" />
    <bpmn:sequenceFlow id="Flow_30" name="Ditolak" sourceRef="Gateway_FinalApprove" targetRef="Task_LepasTopikDitolak" />
    <bpmn:sequenceFlow id="Flow_31" sourceRef="Task_LepasTopikDitolak" targetRef="Gateway_MasihAdaTopik" />
    <bpmn:sequenceFlow id="Flow_32" name="Tidak" sourceRef="Gateway_MasihAdaTopik" targetRef="Task_FinalisasiDitolak" />
    <bpmn:sequenceFlow id="Flow_34" name="Ya" sourceRef="Gateway_MasihAdaTopik" targetRef="Task_ReviewFinal"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${masihAdaTopik}</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_35" name="Disetujui" sourceRef="Gateway_FinalApprove" targetRef="Task_PilihPembimbing2"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${topikFinalDisetujui}</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_36" sourceRef="Task_PilihPembimbing2" targetRef="Task_FinalisasiDisetujui" />
    <bpmn:sequenceFlow id="Flow_37" sourceRef="Task_FinalisasiDisetujui" targetRef="EndEvent_Disetujui" />
    <bpmn:sequenceFlow id="Flow_38" sourceRef="Task_FinalisasiDitolak" targetRef="EndEvent_Ditolak" />

    <bpmn:textAnnotation id="Annotation_Parallel"><bpmn:text>Review dilakukan independen untuk setiap slot topik. Penolakan satu topik tidak menghentikan topik lain. Tidak ada deadline auto-reject pada implementasi saat ini.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_Parallel" sourceRef="Task_ReviewDosen" targetRef="Annotation_Parallel" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="Diagram_TopikDosenAktual">
    <bpmndi:BPMNPlane id="Plane_TopikDosenAktual" bpmnElement="Process_TopikDosenAktual">
      <bpmndi:BPMNShape id="Lane_Sekprodi_di" bpmnElement="Lane_Sekprodi" isHorizontal="true"><dc:Bounds x="40" y="40" width="6720" height="220" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Sistem_di" bpmnElement="Lane_Sistem" isHorizontal="true"><dc:Bounds x="40" y="260" width="6720" height="300" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Mahasiswa_di" bpmnElement="Lane_Mahasiswa" isHorizontal="true"><dc:Bounds x="40" y="560" width="6720" height="180" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Dosen_di" bpmnElement="Lane_Dosen" isHorizontal="true"><dc:Bounds x="40" y="740" width="6720" height="180" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Ketua_di" bpmnElement="Lane_Ketua" isHorizontal="true"><dc:Bounds x="40" y="920" width="6720" height="180" /></bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="StartEvent_Persiapan_di" bpmnElement="StartEvent_Persiapan"><dc:Bounds x="100" y="120" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_SiapkanPeriode_di" bpmnElement="Task_SiapkanPeriode"><dc:Bounds x="170" y="95" width="180" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_TetapkanKetua_di" bpmnElement="Task_TetapkanKetua"><dc:Bounds x="390" y="95" width="190" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ValidasiKesiapan_di" bpmnElement="Task_ValidasiKesiapan"><dc:Bounds x="620" y="330" width="180" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_PeriodeSiap_di" bpmnElement="Gateway_PeriodeSiap" isMarkerVisible="true"><dc:Bounds x="840" y="345" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_PeriodeBelumSiap_di" bpmnElement="EndEvent_PeriodeBelumSiap"><dc:Bounds x="850" y="470" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_AktifkanPeriode_di" bpmnElement="Task_AktifkanPeriode"><dc:Bounds x="930" y="330" width="160" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_PublikasiTopik_di" bpmnElement="Task_PublikasiTopik"><dc:Bounds x="1130" y="790" width="180" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_DaftarPenelitian_di" bpmnElement="Task_DaftarPenelitian"><dc:Bounds x="1350" y="610" width="170" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_AutoApprovePendaftaran_di" bpmnElement="Task_AutoApprovePendaftaran"><dc:Bounds x="1560" y="330" width="190" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_PilihTopik_di" bpmnElement="Task_PilihTopik"><dc:Bounds x="1790" y="610" width="180" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ValidasiTopik_di" bpmnElement="Task_ValidasiTopik"><dc:Bounds x="2020" y="330" width="190" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_DataValid_di" bpmnElement="Gateway_DataValid" isMarkerVisible="true"><dc:Bounds x="2250" y="345" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_PerbaikiPilihan_di" bpmnElement="Task_PerbaikiPilihan"><dc:Bounds x="2190" y="610" width="170" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ReservasiTopik_di" bpmnElement="Task_ReservasiTopik"><dc:Bounds x="2340" y="330" width="210" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ReviewDosen_di" bpmnElement="Task_ReviewDosen" isExpanded="true"><dc:Bounds x="2600" y="790" width="200" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_AdaLolosDosen_di" bpmnElement="Gateway_AdaLolosDosen" isMarkerVisible="true"><dc:Bounds x="2850" y="805" width="50" height="50" /></bpmndi:BPMNShape>

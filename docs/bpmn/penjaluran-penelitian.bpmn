    <bpmn:sequenceFlow id="Flow_Sistem_3" name="Tidak" sourceRef="Gateway_SubmissionValid" targetRef="Task_SendCorrection" />
    <bpmn:sequenceFlow id="Flow_Sistem_4" sourceRef="Task_SendCorrection" targetRef="EndEvent_InvalidSubmission" />
    <bpmn:sequenceFlow id="Flow_Sistem_5" name="Ya" sourceRef="Gateway_SubmissionValid" targetRef="Task_ReserveTopics"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${pengajuanValid}</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Sistem_6" sourceRef="Task_ReserveTopics" targetRef="SubProcess_IndependentTopicReview" />
    <bpmn:sequenceFlow id="Flow_Sistem_7" sourceRef="SubProcess_IndependentTopicReview" targetRef="Gateway_FinalTopicExists" />
    <bpmn:sequenceFlow id="Flow_Sistem_8" name="Ya" sourceRef="Gateway_FinalTopicExists" targetRef="SubProcess_ApproveFinalization"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${topikFinalDipilih}</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Sistem_9" name="Tidak" sourceRef="Gateway_FinalTopicExists" targetRef="SubProcess_RejectFinalization" />
    <bpmn:sequenceFlow id="Flow_Sistem_10" sourceRef="SubProcess_ApproveFinalization" targetRef="Task_SendFinalApproved" />
    <bpmn:sequenceFlow id="Flow_Sistem_11" sourceRef="Task_SendFinalApproved" targetRef="EndEvent_SystemApproved" />
    <bpmn:sequenceFlow id="Flow_Sistem_12" sourceRef="SubProcess_RejectFinalization" targetRef="Task_SendFinalRejected" />
    <bpmn:sequenceFlow id="Flow_Sistem_13" sourceRef="Task_SendFinalRejected" targetRef="EndEvent_SystemRejected" />
  </bpmn:process>


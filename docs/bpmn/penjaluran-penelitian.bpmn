<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_PenjaluranPenelitian"
  targetNamespace="https://simps.uii.ac.id/bpmn/penjaluran-penelitian">

  <bpmn:message id="Message_Submission" name="Pendaftaran penjaluran penelitian" />
  <bpmn:message id="Message_Correction" name="Permintaan perbaikan pengajuan" />
  <bpmn:message id="Message_DosenRequest" name="Permintaan review dosen" />
  <bpmn:message id="Message_DosenDecision" name="Keputusan dosen" />
  <bpmn:message id="Message_ClusterRequest" name="Permintaan review ketua cluster" />
  <bpmn:message id="Message_ClusterDecision" name="Keputusan ketua cluster" />
  <bpmn:message id="Message_SekprodiRequest" name="Permintaan keputusan final" />
  <bpmn:message id="Message_SekprodiDecision" name="Keputusan Sekprodi" />
  <bpmn:message id="Message_FinalApproved" name="Penjaluran disetujui" />
  <bpmn:message id="Message_FinalRejected" name="Penjaluran ditolak" />

  <bpmn:category id="Category_MajorProcess">
    <bpmn:categoryValue id="CategoryValue_Submission" value="1. Pendaftaran Penjaluran Penelitian" />
    <bpmn:categoryValue id="CategoryValue_DosenReview" value="2. Review Dosen Pemilik Topik" />
    <bpmn:categoryValue id="CategoryValue_ClusterReview" value="3. Review Ketua Cluster" />
    <bpmn:categoryValue id="CategoryValue_SekprodiReview" value="4. Keputusan Final dan Penetapan Hasil" />
  </bpmn:category>

  <bpmn:collaboration id="Collaboration_PenjaluranPenelitian" name="Kolaborasi Penjaluran Penelitian">
    <bpmn:participant id="Participant_Mahasiswa" name="Mahasiswa" processRef="Process_Mahasiswa" />
    <bpmn:participant id="Participant_Sistem" name="Sistem SIMPS" processRef="Process_Sistem" />
    <bpmn:participant id="Participant_Dosen" name="Dosen Pemilik Topik" processRef="Process_Dosen" />
    <bpmn:participant id="Participant_KetuaCluster" name="Ketua Cluster" processRef="Process_KetuaCluster" />
    <bpmn:participant id="Participant_Sekprodi" name="Sekretaris Prodi" processRef="Process_Sekprodi" />

    <bpmn:messageFlow id="MessageFlow_Submission" name="Kirim pendaftaran" sourceRef="Task_SubmitSubmission" targetRef="StartEvent_SubmissionReceived" messageRef="Message_Submission" />
    <bpmn:messageFlow id="MessageFlow_Correction" name="Data perlu diperbaiki" sourceRef="Task_SendCorrection" targetRef="CatchEvent_Correction" messageRef="Message_Correction" />
    <bpmn:messageFlow id="MessageFlow_DosenRequest" name="Topik untuk direview" sourceRef="Task_SendDosenRequest" targetRef="StartEvent_DosenRequest" messageRef="Message_DosenRequest" />
    <bpmn:messageFlow id="MessageFlow_DosenDecision" name="Keputusan dosen" sourceRef="Task_SendDosenDecision" targetRef="Task_ReceiveDosenDecision" messageRef="Message_DosenDecision" />
    <bpmn:messageFlow id="MessageFlow_ClusterRequest" name="Topik lolos review dosen" sourceRef="Task_SendClusterRequest" targetRef="StartEvent_ClusterRequest" messageRef="Message_ClusterRequest" />
    <bpmn:messageFlow id="MessageFlow_ClusterDecision" name="Keputusan ketua cluster" sourceRef="Task_SendClusterDecision" targetRef="Task_ReceiveClusterDecision" messageRef="Message_ClusterDecision" />
    <bpmn:messageFlow id="MessageFlow_SekprodiRequest" name="Topik lolos ketua cluster" sourceRef="Task_SendSekprodiRequest" targetRef="StartEvent_SekprodiRequest" messageRef="Message_SekprodiRequest" />
    <bpmn:messageFlow id="MessageFlow_SekprodiDecision" name="Keputusan final per topik" sourceRef="Task_SendSekprodiDecision" targetRef="Task_ReceiveSekprodiDecision" messageRef="Message_SekprodiDecision" />
    <bpmn:messageFlow id="MessageFlow_FinalApproved" name="Hasil disetujui" sourceRef="Task_SendFinalApproved" targetRef="CatchEvent_FinalApproved" messageRef="Message_FinalApproved" />
    <bpmn:messageFlow id="MessageFlow_FinalRejected" name="Hasil ditolak" sourceRef="Task_SendFinalRejected" targetRef="CatchEvent_FinalRejected" messageRef="Message_FinalRejected" />

    <bpmn:group id="Group_Submission" categoryValueRef="CategoryValue_Submission" />
    <bpmn:group id="Group_DosenReview" categoryValueRef="CategoryValue_DosenReview" />
    <bpmn:group id="Group_ClusterReview" categoryValueRef="CategoryValue_ClusterReview" />
    <bpmn:group id="Group_SekprodiReview" categoryValueRef="CategoryValue_SekprodiReview" />
  </bpmn:collaboration>

  <bpmn:process id="Process_Mahasiswa" name="Proses Mahasiswa" isExecutable="false">
    <bpmn:startEvent id="StartEvent_Mahasiswa" name="Periode penjaluran penelitian dibuka">
      <bpmn:outgoing>Flow_Mahasiswa_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_FillSubmission" name="Melakukan pendaftaran penjaluran penelitian">
      <bpmn:incoming>Flow_Mahasiswa_1</bpmn:incoming>
      <bpmn:incoming>Flow_Mahasiswa_7</bpmn:incoming>
      <bpmn:outgoing>Flow_Mahasiswa_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_SelectTopics" name="Pilih maksimal 3 topik penelitian">
      <bpmn:incoming>Flow_Mahasiswa_2</bpmn:incoming>
      <bpmn:outgoing>Flow_Mahasiswa_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="Task_SubmitSubmission" name="Kirim pendaftaran dan pilihan topik">
      <bpmn:incoming>Flow_Mahasiswa_3</bpmn:incoming>
      <bpmn:outgoing>Flow_Mahasiswa_4</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:eventBasedGateway id="Gateway_WaitSubmissionResult" name="Menunggu respons sistem">
      <bpmn:incoming>Flow_Mahasiswa_4</bpmn:incoming>
      <bpmn:outgoing>Flow_Mahasiswa_5</bpmn:outgoing>
      <bpmn:outgoing>Flow_Mahasiswa_8</bpmn:outgoing>
      <bpmn:outgoing>Flow_Mahasiswa_11</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="CatchEvent_Correction" name="Permintaan perbaikan diterima">
      <bpmn:incoming>Flow_Mahasiswa_5</bpmn:incoming>
      <bpmn:outgoing>Flow_Mahasiswa_6</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_Correction" />
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="Task_CorrectSubmission" name="Perbaiki data pengajuan">
      <bpmn:incoming>Flow_Mahasiswa_6</bpmn:incoming>
      <bpmn:outgoing>Flow_Mahasiswa_7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:intermediateCatchEvent id="CatchEvent_FinalApproved" name="Hasil persetujuan diterima">
      <bpmn:incoming>Flow_Mahasiswa_8</bpmn:incoming>
      <bpmn:outgoing>Flow_Mahasiswa_9</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_FinalApproved" />
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="Task_ViewApprovedResult" name="Lihat topik final dan dosen pembimbing">
      <bpmn:incoming>Flow_Mahasiswa_9</bpmn:incoming>
      <bpmn:outgoing>Flow_Mahasiswa_10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="EndEvent_MahasiswaApproved" name="Mahasiswa dapat memulai bimbingan">
      <bpmn:incoming>Flow_Mahasiswa_10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateCatchEvent id="CatchEvent_FinalRejected" name="Hasil penolakan diterima">
      <bpmn:incoming>Flow_Mahasiswa_11</bpmn:incoming>
      <bpmn:outgoing>Flow_Mahasiswa_12</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_FinalRejected" />
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="Task_ViewRejectedResult" name="Lihat hasil dan catatan penolakan">
      <bpmn:incoming>Flow_Mahasiswa_12</bpmn:incoming>
      <bpmn:outgoing>Flow_Mahasiswa_13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="EndEvent_MahasiswaRejected" name="Pengajuan penelitian berakhir">
      <bpmn:incoming>Flow_Mahasiswa_13</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_Mahasiswa_1" sourceRef="StartEvent_Mahasiswa" targetRef="Task_FillSubmission" />
    <bpmn:sequenceFlow id="Flow_Mahasiswa_2" sourceRef="Task_FillSubmission" targetRef="Task_SelectTopics" />
    <bpmn:sequenceFlow id="Flow_Mahasiswa_3" sourceRef="Task_SelectTopics" targetRef="Task_SubmitSubmission" />
    <bpmn:sequenceFlow id="Flow_Mahasiswa_4" sourceRef="Task_SubmitSubmission" targetRef="Gateway_WaitSubmissionResult" />
    <bpmn:sequenceFlow id="Flow_Mahasiswa_5" sourceRef="Gateway_WaitSubmissionResult" targetRef="CatchEvent_Correction" />
    <bpmn:sequenceFlow id="Flow_Mahasiswa_6" sourceRef="CatchEvent_Correction" targetRef="Task_CorrectSubmission" />
    <bpmn:sequenceFlow id="Flow_Mahasiswa_7" sourceRef="Task_CorrectSubmission" targetRef="Task_FillSubmission" />
    <bpmn:sequenceFlow id="Flow_Mahasiswa_8" sourceRef="Gateway_WaitSubmissionResult" targetRef="CatchEvent_FinalApproved" />
    <bpmn:sequenceFlow id="Flow_Mahasiswa_9" sourceRef="CatchEvent_FinalApproved" targetRef="Task_ViewApprovedResult" />
    <bpmn:sequenceFlow id="Flow_Mahasiswa_10" sourceRef="Task_ViewApprovedResult" targetRef="EndEvent_MahasiswaApproved" />
    <bpmn:sequenceFlow id="Flow_Mahasiswa_11" sourceRef="Gateway_WaitSubmissionResult" targetRef="CatchEvent_FinalRejected" />
    <bpmn:sequenceFlow id="Flow_Mahasiswa_12" sourceRef="CatchEvent_FinalRejected" targetRef="Task_ViewRejectedResult" />
    <bpmn:sequenceFlow id="Flow_Mahasiswa_13" sourceRef="Task_ViewRejectedResult" targetRef="EndEvent_MahasiswaRejected" />
  </bpmn:process>

  <bpmn:process id="Process_Sistem" name="Orkestrasi Sistem SIMPS" isExecutable="false">
    <bpmn:property id="Property_SelectedTopics" name="selectedTopics" />
    <bpmn:startEvent id="StartEvent_SubmissionReceived" name="Pendaftaran diterima">
      <bpmn:outgoing>Flow_Sistem_1</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_Submission" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_ValidateSubmission" name="Validasi kelengkapan dan ketersediaan topik">
      <bpmn:incoming>Flow_Sistem_1</bpmn:incoming>
      <bpmn:outgoing>Flow_Sistem_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_SubmissionValid" name="Pengajuan valid?" default="Flow_Sistem_3">
      <bpmn:incoming>Flow_Sistem_2</bpmn:incoming>
      <bpmn:outgoing>Flow_Sistem_3</bpmn:outgoing>
      <bpmn:outgoing>Flow_Sistem_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="Task_SendCorrection" name="Kirim permintaan perbaikan">
      <bpmn:incoming>Flow_Sistem_3</bpmn:incoming>
      <bpmn:outgoing>Flow_Sistem_4</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="EndEvent_InvalidSubmission" name="Menunggu pengajuan diperbaiki">
      <bpmn:incoming>Flow_Sistem_4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Task_ReserveTopics" name="Reservasi topik dan buat status pengajuan">
      <bpmn:incoming>Flow_Sistem_5</bpmn:incoming>
      <bpmn:outgoing>Flow_Sistem_6</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:subProcess id="SubProcess_IndependentTopicReview" name="Proses Review Independen per Topik">
      <bpmn:incoming>Flow_Sistem_6</bpmn:incoming>
      <bpmn:outgoing>Flow_Sistem_7</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics isSequential="false">
        <bpmn:loopDataInputRef>Property_SelectedTopics</bpmn:loopDataInputRef>
        <bpmn:inputDataItem id="DataItem_CurrentTopic" name="topik" />
        <bpmn:completionCondition xsi:type="bpmn:tFormalExpression">${topikFinalDipilih || seluruhTopikSelesai}</bpmn:completionCondition>
      </bpmn:multiInstanceLoopCharacteristics>

      <bpmn:startEvent id="StartEvent_TopicInstance" name="Workflow topik dibuat">
        <bpmn:outgoing>Flow_Topic_1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:sendTask id="Task_SendDosenRequest" name="Kirim permintaan review kepada dosen">
        <bpmn:incoming>Flow_Topic_1</bpmn:incoming>
        <bpmn:outgoing>Flow_Topic_2</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:receiveTask id="Task_ReceiveDosenDecision" name="Terima keputusan dosen">
        <bpmn:incoming>Flow_Topic_2</bpmn:incoming>
        <bpmn:outgoing>Flow_Topic_3</bpmn:outgoing>
      </bpmn:receiveTask>
      <bpmn:exclusiveGateway id="Gateway_DosenApproved" name="Dosen approve?" default="Flow_Topic_4">
        <bpmn:incoming>Flow_Topic_3</bpmn:incoming>
        <bpmn:outgoing>Flow_Topic_4</bpmn:outgoing>
        <bpmn:outgoing>Flow_Topic_5</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:sendTask id="Task_SendClusterRequest" name="Kirim permintaan review kepada ketua cluster">
        <bpmn:incoming>Flow_Topic_5</bpmn:incoming>
        <bpmn:outgoing>Flow_Topic_6</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:receiveTask id="Task_ReceiveClusterDecision" name="Terima keputusan ketua cluster">
        <bpmn:incoming>Flow_Topic_6</bpmn:incoming>
        <bpmn:outgoing>Flow_Topic_7</bpmn:outgoing>
      </bpmn:receiveTask>
      <bpmn:exclusiveGateway id="Gateway_ClusterApproved" name="Ketua cluster approve?" default="Flow_Topic_8">
        <bpmn:incoming>Flow_Topic_7</bpmn:incoming>
        <bpmn:outgoing>Flow_Topic_8</bpmn:outgoing>
        <bpmn:outgoing>Flow_Topic_9</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:sendTask id="Task_SendSekprodiRequest" name="Kirim permintaan keputusan final kepada Sekprodi">
        <bpmn:incoming>Flow_Topic_9</bpmn:incoming>
        <bpmn:outgoing>Flow_Topic_10</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:receiveTask id="Task_ReceiveSekprodiDecision" name="Terima keputusan final Sekprodi">
        <bpmn:incoming>Flow_Topic_10</bpmn:incoming>
        <bpmn:outgoing>Flow_Topic_11</bpmn:outgoing>
      </bpmn:receiveTask>
      <bpmn:exclusiveGateway id="Gateway_SekprodiApproved" name="Sekprodi approve?" default="Flow_Topic_12">
        <bpmn:incoming>Flow_Topic_11</bpmn:incoming>
        <bpmn:outgoing>Flow_Topic_12</bpmn:outgoing>
        <bpmn:outgoing>Flow_Topic_14</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="Task_CloseRejectedTopicDosen" name="Tutup topik dan lepaskan reservasi">
        <bpmn:incoming>Flow_Topic_4</bpmn:incoming>
        <bpmn:outgoing>Flow_Topic_13_Dosen</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="EndEvent_TopicRejectedDosen" name="Topik ditolak dosen">
        <bpmn:incoming>Flow_Topic_13_Dosen</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:serviceTask id="Task_CloseRejectedTopicCluster" name="Tutup topik dan lepaskan reservasi">
        <bpmn:incoming>Flow_Topic_8</bpmn:incoming>
        <bpmn:outgoing>Flow_Topic_13_Cluster</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="EndEvent_TopicRejectedCluster" name="Topik ditolak ketua cluster">
        <bpmn:incoming>Flow_Topic_13_Cluster</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:serviceTask id="Task_CloseRejectedTopicSekprodi" name="Tutup topik dan lepaskan reservasi">
        <bpmn:incoming>Flow_Topic_12</bpmn:incoming>
        <bpmn:outgoing>Flow_Topic_13</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="EndEvent_TopicRejectedSekprodi" name="Topik ditolak Sekprodi">
        <bpmn:incoming>Flow_Topic_13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:serviceTask id="Task_SetFinalWinner" name="Tandai topik sebagai topik final">
        <bpmn:incoming>Flow_Topic_14</bpmn:incoming>
        <bpmn:outgoing>Flow_Topic_15</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="EndEvent_TopicApproved" name="Topik final terpilih">
        <bpmn:incoming>Flow_Topic_15</bpmn:incoming>
      </bpmn:endEvent>

      <bpmn:sequenceFlow id="Flow_Topic_1" sourceRef="StartEvent_TopicInstance" targetRef="Task_SendDosenRequest" />
      <bpmn:sequenceFlow id="Flow_Topic_2" sourceRef="Task_SendDosenRequest" targetRef="Task_ReceiveDosenDecision" />
      <bpmn:sequenceFlow id="Flow_Topic_3" sourceRef="Task_ReceiveDosenDecision" targetRef="Gateway_DosenApproved" />
      <bpmn:sequenceFlow id="Flow_Topic_4" name="Reject" sourceRef="Gateway_DosenApproved" targetRef="Task_CloseRejectedTopicDosen" />
      <bpmn:sequenceFlow id="Flow_Topic_5" name="Approve" sourceRef="Gateway_DosenApproved" targetRef="Task_SendClusterRequest">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${dosenApprove}</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_Topic_6" sourceRef="Task_SendClusterRequest" targetRef="Task_ReceiveClusterDecision" />
      <bpmn:sequenceFlow id="Flow_Topic_7" sourceRef="Task_ReceiveClusterDecision" targetRef="Gateway_ClusterApproved" />
      <bpmn:sequenceFlow id="Flow_Topic_8" name="Reject" sourceRef="Gateway_ClusterApproved" targetRef="Task_CloseRejectedTopicCluster" />
      <bpmn:sequenceFlow id="Flow_Topic_9" name="Approve" sourceRef="Gateway_ClusterApproved" targetRef="Task_SendSekprodiRequest">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${ketuaClusterApprove}</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_Topic_10" sourceRef="Task_SendSekprodiRequest" targetRef="Task_ReceiveSekprodiDecision" />
      <bpmn:sequenceFlow id="Flow_Topic_11" sourceRef="Task_ReceiveSekprodiDecision" targetRef="Gateway_SekprodiApproved" />
      <bpmn:sequenceFlow id="Flow_Topic_12" name="Reject" sourceRef="Gateway_SekprodiApproved" targetRef="Task_CloseRejectedTopicSekprodi" />
      <bpmn:sequenceFlow id="Flow_Topic_13_Dosen" sourceRef="Task_CloseRejectedTopicDosen" targetRef="EndEvent_TopicRejectedDosen" />
      <bpmn:sequenceFlow id="Flow_Topic_13_Cluster" sourceRef="Task_CloseRejectedTopicCluster" targetRef="EndEvent_TopicRejectedCluster" />
      <bpmn:sequenceFlow id="Flow_Topic_13" sourceRef="Task_CloseRejectedTopicSekprodi" targetRef="EndEvent_TopicRejectedSekprodi" />
      <bpmn:sequenceFlow id="Flow_Topic_14" name="Approve" sourceRef="Gateway_SekprodiApproved" targetRef="Task_SetFinalWinner">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${sekprodiApprove}</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_Topic_15" sourceRef="Task_SetFinalWinner" targetRef="EndEvent_TopicApproved" />
    </bpmn:subProcess>

    <bpmn:exclusiveGateway id="Gateway_FinalTopicExists" name="Ada topik final?" default="Flow_Sistem_9">
      <bpmn:incoming>Flow_Sistem_7</bpmn:incoming>
      <bpmn:outgoing>Flow_Sistem_8</bpmn:outgoing>
      <bpmn:outgoing>Flow_Sistem_9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:subProcess id="SubProcess_ApproveFinalization" name="Finalisasi Penjaluran Disetujui">
      <bpmn:incoming>Flow_Sistem_8</bpmn:incoming>
      <bpmn:outgoing>Flow_Sistem_10</bpmn:outgoing>
      <bpmn:startEvent id="StartEvent_ApproveFinalization"><bpmn:outgoing>Flow_Approve_1</bpmn:outgoing></bpmn:startEvent>
      <bpmn:serviceTask id="Task_CancelOtherTopics" name="Batalkan workflow topik lainnya"><bpmn:incoming>Flow_Approve_1</bpmn:incoming><bpmn:outgoing>Flow_Approve_2</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:serviceTask id="Task_ReleaseOtherTopics" name="Kembalikan topik lain menjadi available"><bpmn:incoming>Flow_Approve_2</bpmn:incoming><bpmn:outgoing>Flow_Approve_3</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:serviceTask id="Task_AssignSupervisor" name="Tetapkan dosen pemilik topik sebagai pembimbing"><bpmn:incoming>Flow_Approve_3</bpmn:incoming><bpmn:outgoing>Flow_Approve_4</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:serviceTask id="Task_EnableGuidance" name="Setujui penjaluran dan aktifkan bimbingan"><bpmn:incoming>Flow_Approve_4</bpmn:incoming><bpmn:outgoing>Flow_Approve_5</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:endEvent id="EndEvent_ApproveFinalization"><bpmn:incoming>Flow_Approve_5</bpmn:incoming></bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_Approve_1" sourceRef="StartEvent_ApproveFinalization" targetRef="Task_CancelOtherTopics" />
      <bpmn:sequenceFlow id="Flow_Approve_2" sourceRef="Task_CancelOtherTopics" targetRef="Task_ReleaseOtherTopics" />
      <bpmn:sequenceFlow id="Flow_Approve_3" sourceRef="Task_ReleaseOtherTopics" targetRef="Task_AssignSupervisor" />
      <bpmn:sequenceFlow id="Flow_Approve_4" sourceRef="Task_AssignSupervisor" targetRef="Task_EnableGuidance" />
      <bpmn:sequenceFlow id="Flow_Approve_5" sourceRef="Task_EnableGuidance" targetRef="EndEvent_ApproveFinalization" />
    </bpmn:subProcess>
    <bpmn:sendTask id="Task_SendFinalApproved" name="Kirim hasil penjaluran disetujui">
      <bpmn:incoming>Flow_Sistem_10</bpmn:incoming>
      <bpmn:outgoing>Flow_Sistem_11</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="EndEvent_SystemApproved" name="Penjaluran disetujui dan bimbingan aktif"><bpmn:incoming>Flow_Sistem_11</bpmn:incoming></bpmn:endEvent>

    <bpmn:subProcess id="SubProcess_RejectFinalization" name="Finalisasi Penjaluran Ditolak">
      <bpmn:incoming>Flow_Sistem_9</bpmn:incoming>
      <bpmn:outgoing>Flow_Sistem_12</bpmn:outgoing>
      <bpmn:startEvent id="StartEvent_RejectFinalization"><bpmn:outgoing>Flow_Reject_1</bpmn:outgoing></bpmn:startEvent>
      <bpmn:serviceTask id="Task_ReleaseAllTopics" name="Lepaskan reservasi seluruh topik"><bpmn:incoming>Flow_Reject_1</bpmn:incoming><bpmn:outgoing>Flow_Reject_2</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:serviceTask id="Task_SetRejectedStatus" name="Tetapkan status penjaluran ditolak"><bpmn:incoming>Flow_Reject_2</bpmn:incoming><bpmn:outgoing>Flow_Reject_3</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:endEvent id="EndEvent_RejectFinalization"><bpmn:incoming>Flow_Reject_3</bpmn:incoming></bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_Reject_1" sourceRef="StartEvent_RejectFinalization" targetRef="Task_ReleaseAllTopics" />
      <bpmn:sequenceFlow id="Flow_Reject_2" sourceRef="Task_ReleaseAllTopics" targetRef="Task_SetRejectedStatus" />
      <bpmn:sequenceFlow id="Flow_Reject_3" sourceRef="Task_SetRejectedStatus" targetRef="EndEvent_RejectFinalization" />
    </bpmn:subProcess>
    <bpmn:sendTask id="Task_SendFinalRejected" name="Kirim hasil penjaluran ditolak">
      <bpmn:incoming>Flow_Sistem_12</bpmn:incoming>
      <bpmn:outgoing>Flow_Sistem_13</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="EndEvent_SystemRejected" name="Penjaluran penelitian ditolak"><bpmn:incoming>Flow_Sistem_13</bpmn:incoming></bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_Sistem_1" sourceRef="StartEvent_SubmissionReceived" targetRef="Task_ValidateSubmission" />

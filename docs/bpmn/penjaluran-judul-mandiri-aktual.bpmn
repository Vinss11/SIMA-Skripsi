<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_JudulMandiriAktual"
  targetNamespace="https://sima.uii.ac.id/bpmn/penjaluran-judul-mandiri-aktual">

  <bpmn:process id="Process_JudulMandiriAktual" name="Penjaluran Penelitian - Judul Mandiri (Implementasi Aktual)" isExecutable="false">
    <bpmn:laneSet id="LaneSet_JudulMandiri">
      <bpmn:lane id="Lane_Sekprodi" name="Sekretaris Prodi">
        <bpmn:flowNodeRef>StartEvent_Persiapan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SiapkanPeriode</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TetapkanKetua</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PerbaikiMapping</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReviewFinal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_FinalApprove</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PilihPembimbing2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Sistem" name="Sistem SIMA">
        <bpmn:flowNodeRef>Task_ValidasiKesiapan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_PeriodeSiap</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_PeriodeBelumSiap</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AktifkanPeriode</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AutoApprovePendaftaran</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ValidasiMandiri</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_DataValid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_BuatPengajuan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ResolusiKetua</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_KetuaTersedia</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SinkronkanMapping</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_PembimbingKetua</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AutoApproveKetua</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FinalisasiDisetujui</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FinalisasiDitolak</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Disetujui</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Ditolak</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Mahasiswa" name="Mahasiswa">
        <bpmn:flowNodeRef>Task_DaftarPenelitian</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_IsiJudulMandiri</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PerbaikiPengajuan</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Dosen" name="Calon Dosen Pembimbing">
        <bpmn:flowNodeRef>Task_ReviewPembimbing</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_PembimbingApprove</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Ketua" name="Ketua Klaster">
        <bpmn:flowNodeRef>Task_ReviewKetua</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_KetuaApprove</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="StartEvent_Persiapan" name="Persiapan periode penjaluran"><bpmn:outgoing>Flow_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:userTask id="Task_SiapkanPeriode" name="Buat draft periode dan atur ketersediaan dosen"><bpmn:incoming>Flow_01</bpmn:incoming><bpmn:outgoing>Flow_02</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="Task_TetapkanKetua" name="Tetapkan Ketua Klaster SIRKEL, SIBER, ITSC, MVK"><bpmn:incoming>Flow_02</bpmn:incoming><bpmn:outgoing>Flow_03</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="Task_ValidasiKesiapan" name="Validasi penanggung jawab dan kesiapan periode"><bpmn:incoming>Flow_03</bpmn:incoming><bpmn:outgoing>Flow_04</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_PeriodeSiap" name="Periode siap diaktifkan?" default="Flow_05"><bpmn:incoming>Flow_04</bpmn:incoming><bpmn:outgoing>Flow_05</bpmn:outgoing><bpmn:outgoing>Flow_06</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:endEvent id="EndEvent_PeriodeBelumSiap" name="Periode belum dapat dibuka"><bpmn:incoming>Flow_05</bpmn:incoming></bpmn:endEvent>
    <bpmn:serviceTask id="Task_AktifkanPeriode" name="Aktifkan periode penjaluran"><bpmn:incoming>Flow_06</bpmn:incoming><bpmn:outgoing>Flow_07</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="Task_DaftarPenelitian" name="Daftar jalur penelitian dan login"><bpmn:incoming>Flow_07</bpmn:incoming><bpmn:outgoing>Flow_08</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="Task_AutoApprovePendaftaran" name="Buat pendaftaran approved dan form lanjutan draft"><bpmn:incoming>Flow_08</bpmn:incoming><bpmn:outgoing>Flow_09</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="Task_IsiJudulMandiri" name="Isi judul, deskripsi, keyword, klaster, dan calon pembimbing"><bpmn:incoming>Flow_09</bpmn:incoming><bpmn:incoming>Flow_13</bpmn:incoming><bpmn:outgoing>Flow_10</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="Task_ValidasiMandiri" name="Validasi eligibility, kesesuaian klaster, ketersediaan, dan kuota"><bpmn:incoming>Flow_10</bpmn:incoming><bpmn:outgoing>Flow_11</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_DataValid" name="Pengajuan valid?" default="Flow_12"><bpmn:incoming>Flow_11</bpmn:incoming><bpmn:outgoing>Flow_12</bpmn:outgoing><bpmn:outgoing>Flow_14</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_PerbaikiPengajuan" name="Perbaiki data judul mandiri"><bpmn:incoming>Flow_12</bpmn:incoming><bpmn:outgoing>Flow_13</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="Task_BuatPengajuan" name="Buat Pengajuan pending dan arahkan ke calon pembimbing"><bpmn:incoming>Flow_14</bpmn:incoming><bpmn:outgoing>Flow_15</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="Task_ReviewPembimbing" name="Tinjau judul mandiri dan isi catatan keputusan"><bpmn:incoming>Flow_15</bpmn:incoming><bpmn:outgoing>Flow_16</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_PembimbingApprove" name="Calon pembimbing menyetujui?" default="Flow_17"><bpmn:incoming>Flow_16</bpmn:incoming><bpmn:outgoing>Flow_17</bpmn:outgoing><bpmn:outgoing>Flow_18</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_ResolusiKetua" name="Cari Ketua Klaster sesuai klaster judul"><bpmn:incoming>Flow_18</bpmn:incoming><bpmn:incoming>Flow_23</bpmn:incoming><bpmn:outgoing>Flow_19</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_KetuaTersedia" name="Mapping Ketua Klaster tersedia?" default="Flow_20"><bpmn:incoming>Flow_19</bpmn:incoming><bpmn:outgoing>Flow_20</bpmn:outgoing><bpmn:outgoing>Flow_24</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_PerbaikiMapping" name="Tetapkan atau perbaiki mapping Ketua Klaster"><bpmn:incoming>Flow_20</bpmn:incoming><bpmn:outgoing>Flow_21</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="Task_SinkronkanMapping" name="Rekonsiliasi pengajuan menunggu Ketua Klaster"><bpmn:incoming>Flow_21</bpmn:incoming><bpmn:outgoing>Flow_23</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_PembimbingKetua" name="Calon pembimbing juga Ketua Klaster?" default="Flow_25"><bpmn:incoming>Flow_24</bpmn:incoming><bpmn:outgoing>Flow_25</bpmn:outgoing><bpmn:outgoing>Flow_26</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_AutoApproveKetua" name="Catat auto-approval Ketua Klaster"><bpmn:incoming>Flow_26</bpmn:incoming><bpmn:outgoing>Flow_30</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="Task_ReviewKetua" name="Tinjau kesesuaian judul dengan klaster"><bpmn:incoming>Flow_25</bpmn:incoming><bpmn:outgoing>Flow_27</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_KetuaApprove" name="Ketua Klaster menyetujui?" default="Flow_28"><bpmn:incoming>Flow_27</bpmn:incoming><bpmn:outgoing>Flow_28</bpmn:outgoing><bpmn:outgoing>Flow_29</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_ReviewFinal" name="Tinjau pengajuan dan isi catatan final"><bpmn:incoming>Flow_29</bpmn:incoming><bpmn:incoming>Flow_30</bpmn:incoming><bpmn:outgoing>Flow_31</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_FinalApprove" name="Sekprodi menyetujui?" default="Flow_32"><bpmn:incoming>Flow_31</bpmn:incoming><bpmn:outgoing>Flow_32</bpmn:outgoing><bpmn:outgoing>Flow_33</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_PilihPembimbing2" name="Tetapkan calon pembimbing sebagai Pembimbing 1 dan pilih Pembimbing 2"><bpmn:incoming>Flow_33</bpmn:incoming><bpmn:outgoing>Flow_34</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="Task_FinalisasiDisetujui" name="Set approved; simpan penetapan pembimbing; reset pengajuan aktif"><bpmn:incoming>Flow_34</bpmn:incoming><bpmn:outgoing>Flow_35</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="Task_FinalisasiDitolak" name="Set rejected; simpan alasan; reset pengajuan aktif"><bpmn:incoming>Flow_17</bpmn:incoming><bpmn:incoming>Flow_28</bpmn:incoming><bpmn:incoming>Flow_32</bpmn:incoming><bpmn:outgoing>Flow_36</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_Disetujui" name="Penjaluran penelitian disetujui"><bpmn:incoming>Flow_35</bpmn:incoming></bpmn:endEvent>
    <bpmn:endEvent id="EndEvent_Ditolak" name="Penjaluran penelitian ditolak"><bpmn:incoming>Flow_36</bpmn:incoming></bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_01" sourceRef="StartEvent_Persiapan" targetRef="Task_SiapkanPeriode" />
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_SiapkanPeriode" targetRef="Task_TetapkanKetua" />
    <bpmn:sequenceFlow id="Flow_03" sourceRef="Task_TetapkanKetua" targetRef="Task_ValidasiKesiapan" />
    <bpmn:sequenceFlow id="Flow_04" sourceRef="Task_ValidasiKesiapan" targetRef="Gateway_PeriodeSiap" />
    <bpmn:sequenceFlow id="Flow_05" name="Tidak" sourceRef="Gateway_PeriodeSiap" targetRef="EndEvent_PeriodeBelumSiap" />
    <bpmn:sequenceFlow id="Flow_06" name="Ya" sourceRef="Gateway_PeriodeSiap" targetRef="Task_AktifkanPeriode"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${periodeSiap}</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_07" sourceRef="Task_AktifkanPeriode" targetRef="Task_DaftarPenelitian" />
    <bpmn:sequenceFlow id="Flow_08" sourceRef="Task_DaftarPenelitian" targetRef="Task_AutoApprovePendaftaran" />
    <bpmn:sequenceFlow id="Flow_09" sourceRef="Task_AutoApprovePendaftaran" targetRef="Task_IsiJudulMandiri" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_IsiJudulMandiri" targetRef="Task_ValidasiMandiri" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_ValidasiMandiri" targetRef="Gateway_DataValid" />
    <bpmn:sequenceFlow id="Flow_12" name="Tidak" sourceRef="Gateway_DataValid" targetRef="Task_PerbaikiPengajuan" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_PerbaikiPengajuan" targetRef="Task_IsiJudulMandiri" />
    <bpmn:sequenceFlow id="Flow_14" name="Ya" sourceRef="Gateway_DataValid" targetRef="Task_BuatPengajuan"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${pengajuanValid}</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Task_BuatPengajuan" targetRef="Task_ReviewPembimbing" />
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Task_ReviewPembimbing" targetRef="Gateway_PembimbingApprove" />
    <bpmn:sequenceFlow id="Flow_17" name="Tidak" sourceRef="Gateway_PembimbingApprove" targetRef="Task_FinalisasiDitolak" />
    <bpmn:sequenceFlow id="Flow_18" name="Ya" sourceRef="Gateway_PembimbingApprove" targetRef="Task_ResolusiKetua"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${pembimbingApprove}</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_19" sourceRef="Task_ResolusiKetua" targetRef="Gateway_KetuaTersedia" />
    <bpmn:sequenceFlow id="Flow_20" name="Tidak" sourceRef="Gateway_KetuaTersedia" targetRef="Task_PerbaikiMapping" />
    <bpmn:sequenceFlow id="Flow_21" sourceRef="Task_PerbaikiMapping" targetRef="Task_SinkronkanMapping" />
    <bpmn:sequenceFlow id="Flow_23" sourceRef="Task_SinkronkanMapping" targetRef="Task_ResolusiKetua" />
    <bpmn:sequenceFlow id="Flow_24" name="Ya" sourceRef="Gateway_KetuaTersedia" targetRef="Gateway_PembimbingKetua"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${ketuaTersedia}</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_25" name="Tidak" sourceRef="Gateway_PembimbingKetua" targetRef="Task_ReviewKetua" />
    <bpmn:sequenceFlow id="Flow_26" name="Ya" sourceRef="Gateway_PembimbingKetua" targetRef="Task_AutoApproveKetua"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${pembimbingAdalahKetua}</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_27" sourceRef="Task_ReviewKetua" targetRef="Gateway_KetuaApprove" />
    <bpmn:sequenceFlow id="Flow_28" name="Tidak" sourceRef="Gateway_KetuaApprove" targetRef="Task_FinalisasiDitolak" />
    <bpmn:sequenceFlow id="Flow_29" name="Ya" sourceRef="Gateway_KetuaApprove" targetRef="Task_ReviewFinal"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${ketuaApprove}</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_30" sourceRef="Task_AutoApproveKetua" targetRef="Task_ReviewFinal" />
    <bpmn:sequenceFlow id="Flow_31" sourceRef="Task_ReviewFinal" targetRef="Gateway_FinalApprove" />
    <bpmn:sequenceFlow id="Flow_32" name="Tidak" sourceRef="Gateway_FinalApprove" targetRef="Task_FinalisasiDitolak" />
    <bpmn:sequenceFlow id="Flow_33" name="Ya" sourceRef="Gateway_FinalApprove" targetRef="Task_PilihPembimbing2"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${sekprodiApprove}</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_34" sourceRef="Task_PilihPembimbing2" targetRef="Task_FinalisasiDisetujui" />
    <bpmn:sequenceFlow id="Flow_35" sourceRef="Task_FinalisasiDisetujui" targetRef="EndEvent_Disetujui" />
    <bpmn:sequenceFlow id="Flow_36" sourceRef="Task_FinalisasiDitolak" targetRef="EndEvent_Ditolak" />

    <bpmn:textAnnotation id="Annotation_NoRevision"><bpmn:text>Penolakan oleh calon pembimbing, Ketua Klaster, atau Sekprodi bersifat final untuk record pengajuan. Implementasi saat ini tidak memiliki loop revisi setelah review.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_NoRevision" sourceRef="Task_FinalisasiDitolak" targetRef="Annotation_NoRevision" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="Diagram_JudulMandiriAktual">
    <bpmndi:BPMNPlane id="Plane_JudulMandiriAktual" bpmnElement="Process_JudulMandiriAktual">
      <bpmndi:BPMNShape id="Lane_Sekprodi_di" bpmnElement="Lane_Sekprodi" isHorizontal="true"><dc:Bounds x="40" y="40" width="6000" height="220" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Sistem_di" bpmnElement="Lane_Sistem" isHorizontal="true"><dc:Bounds x="40" y="260" width="6000" height="300" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Mahasiswa_di" bpmnElement="Lane_Mahasiswa" isHorizontal="true"><dc:Bounds x="40" y="560" width="6000" height="180" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Dosen_di" bpmnElement="Lane_Dosen" isHorizontal="true"><dc:Bounds x="40" y="740" width="6000" height="180" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Ketua_di" bpmnElement="Lane_Ketua" isHorizontal="true"><dc:Bounds x="40" y="920" width="6000" height="180" /></bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="StartEvent_Persiapan_di" bpmnElement="StartEvent_Persiapan"><dc:Bounds x="100" y="120" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_SiapkanPeriode_di" bpmnElement="Task_SiapkanPeriode"><dc:Bounds x="170" y="95" width="180" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_TetapkanKetua_di" bpmnElement="Task_TetapkanKetua"><dc:Bounds x="390" y="95" width="190" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ValidasiKesiapan_di" bpmnElement="Task_ValidasiKesiapan"><dc:Bounds x="620" y="330" width="180" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_PeriodeSiap_di" bpmnElement="Gateway_PeriodeSiap" isMarkerVisible="true"><dc:Bounds x="840" y="345" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_PeriodeBelumSiap_di" bpmnElement="EndEvent_PeriodeBelumSiap"><dc:Bounds x="850" y="470" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_AktifkanPeriode_di" bpmnElement="Task_AktifkanPeriode"><dc:Bounds x="930" y="330" width="160" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_DaftarPenelitian_di" bpmnElement="Task_DaftarPenelitian"><dc:Bounds x="1130" y="610" width="170" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_AutoApprovePendaftaran_di" bpmnElement="Task_AutoApprovePendaftaran"><dc:Bounds x="1340" y="330" width="190" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_IsiJudulMandiri_di" bpmnElement="Task_IsiJudulMandiri"><dc:Bounds x="1570" y="610" width="210" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ValidasiMandiri_di" bpmnElement="Task_ValidasiMandiri"><dc:Bounds x="1820" y="330" width="200" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_DataValid_di" bpmnElement="Gateway_DataValid" isMarkerVisible="true"><dc:Bounds x="2060" y="345" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_PerbaikiPengajuan_di" bpmnElement="Task_PerbaikiPengajuan"><dc:Bounds x="2000" y="610" width="170" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_BuatPengajuan_di" bpmnElement="Task_BuatPengajuan"><dc:Bounds x="2160" y="330" width="200" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ReviewPembimbing_di" bpmnElement="Task_ReviewPembimbing"><dc:Bounds x="2410" y="790" width="190" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_PembimbingApprove_di" bpmnElement="Gateway_PembimbingApprove" isMarkerVisible="true"><dc:Bounds x="2650" y="805" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ResolusiKetua_di" bpmnElement="Task_ResolusiKetua"><dc:Bounds x="2750" y="330" width="180" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_KetuaTersedia_di" bpmnElement="Gateway_KetuaTersedia" isMarkerVisible="true"><dc:Bounds x="2980" y="345" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_PerbaikiMapping_di" bpmnElement="Task_PerbaikiMapping"><dc:Bounds x="2940" y="95" width="180" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_SinkronkanMapping_di" bpmnElement="Task_SinkronkanMapping"><dc:Bounds x="3160" y="330" width="180" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_PembimbingKetua_di" bpmnElement="Gateway_PembimbingKetua" isMarkerVisible="true"><dc:Bounds x="3160" y="455" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_AutoApproveKetua_di" bpmnElement="Task_AutoApproveKetua"><dc:Bounds x="3380" y="440" width="180" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ReviewKetua_di" bpmnElement="Task_ReviewKetua"><dc:Bounds x="3380" y="970" width="190" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_KetuaApprove_di" bpmnElement="Gateway_KetuaApprove" isMarkerVisible="true"><dc:Bounds x="3620" y="985" width="50" height="50" /></bpmndi:BPMNShape>

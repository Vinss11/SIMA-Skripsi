NODE_ENV=development
PORT=3000

# Local development DB (PostgreSQL)
# Example:
# DATABASE_URL_DEV=postgresql://postgres:password@127.0.0.1:5432/SIMAdb
DATABASE_URL_DEV=

# Local test DB (PostgreSQL)
# Example:
# DATABASE_URL_TEST=postgresql://postgres:password@127.0.0.1:5432/SIMAdb_test
DATABASE_URL_TEST=

# Production DB connection string (Neon/Render):
# Example format:
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
DATABASE_URL=

# Comma-separated frontend origins allowed to call this API.
# Localhost and 127.0.0.1 on any port are automatically allowed only in development.
# Production should list the canonical frontend and any custom domain explicitly.
# Example:
# CORS_ORIGINS=https://your-vercel-app.vercel.app,https://skripsi.example.ac.id
CORS_ORIGINS=

# Authentication and session security. Generate independent random secrets;
# placeholder values intentionally fail closed.
JWT_SECRET=change-me-with-at-least-32-random-bytes
JWT_ISSUER=sima
JWT_AUDIENCE=sima-api
JWT_ACCESS_EXPIRES_IN=15m
AUTH_SESSION_HOURS=12
AUTH_SESSION_IDLE_MINUTES=60
AUTH_PASSWORD_MIN_LENGTH=10
AUTH_RECOVERY_ENABLED=false
AUTH_DELIVERY_KEY=change-me-with-32-byte-base64-or-64-char-hex
AUTH_DELIVERY_KEY_VERSION=v1
AUTH_FRONTEND_ORIGIN=http://localhost:3000
# Only for the one-time production Admin bootstrap seeder; provide a bcrypt hash,
# never plaintext, and remove it from the runtime environment after seeding.
BOOTSTRAP_ADMIN_PASSWORD_HASH=

# Vercel sets VERCEL=1 automatically. Local development does not need this.
